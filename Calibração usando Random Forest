def ler_base_csv(arquivo):
    """
    Lê CSV separado por vírgula ou ponto e vírgula.
    """

    try:
        df_temp = pd.read_csv(
            arquivo,
            sep=",",
            decimal=".",
            encoding="utf-8-sig",
            low_memory=False
        )

        if df_temp.shape[1] > 1:
            print("Separador identificado: vírgula ','")
            return df_temp

    except Exception:
        pass

    try:
        df_temp = pd.read_csv(
            arquivo,
            sep=";",
            decimal=".",
            encoding="utf-8-sig",
            low_memory=False
        )

        if df_temp.shape[1] > 1:
            print("Separador identificado: ponto e vírgula ';'")
            return df_temp

    except Exception:
        pass

    df_temp = pd.read_csv(
        arquivo,
        sep=None,
        engine="python",
        decimal=".",
        encoding="utf-8-sig"
    )

    print("Separador identificado automaticamente.")
    return df_temp


def converter_numero(valor):
    """
    Converte texto para número.
    Não altera escala, não multiplica e não divide.
    """

    if pd.isna(valor):
        return np.nan

    s = str(valor).strip()

    if s == "" or s.lower() in ["nan", "none", "null"]:
        return np.nan

    s = s.replace(" ", "")

    # Formato brasileiro: 1.234,56
    if "," in s and "." in s:

        if s.rfind(",") > s.rfind("."):
            s = s.replace(".", "")
            s = s.replace(",", ".")

        # Formato americano: 1,234.56
        else:
            s = s.replace(",", "")

    # Apenas vírgula decimal
    elif "," in s:
        s = s.replace(",", ".")

    # Caso com vários pontos
    if s.count(".") > 1:
        partes = s.split(".")
        s = partes[0] + "." + "".join(partes[1:])

    return pd.to_numeric(s, errors="coerce")


def escolher_target(df, opcoes):
    """
    Escolhe automaticamente a coluna de referência existente.
    """

    for col in opcoes:
        if col in df.columns:
            return col

    raise KeyError(
        "Nenhuma coluna de referência foi encontrada.\n"
        f"Opções esperadas: {opcoes}\n\n"
        f"Colunas disponíveis:\n{df.columns.tolist()}"
    )


def calcular_metricas(y_real, y_pred):
    """
    Calcula RMSE, MAE, R2 e Pearson.
    """

    y_real = np.asarray(y_real, dtype=float)
    y_pred = np.asarray(y_pred, dtype=float)

    mse = mean_squared_error(y_real, y_pred)
    rmse = np.sqrt(mse)
    mae = mean_absolute_error(y_real, y_pred)
    r2 = r2_score(y_real, y_pred)

    if len(y_real) > 1 and np.std(y_real) > 0 and np.std(y_pred) > 0:
        pearson = pearsonr(y_real, y_pred)[0]
    else:
        pearson = np.nan

    return {
        "N": len(y_real),
        "RMSE": rmse,
        "MAE": mae,
        "R2": r2,
        "Pearson": pearson
    }


