def ler_base_csv(arquivo):
    """
    Lê CSV separado por vírgula ou ponto e vírgula.
    """

    try:
        df_temp = pd.read_csv(
            arquivo,
            sep=",",
            decimal=".",
            encoding="utf-8-sig",
            low_memory=False
        )

        if df_temp.shape[1] > 1:
            print("Separador identificado: vírgula ','")
            return df_temp

    except Exception:
        pass

    try:
        df_temp = pd.read_csv(
            arquivo,
            sep=";",
            decimal=".",
            encoding="utf-8-sig",
            low_memory=False
        )

        if df_temp.shape[1] > 1:
            print("Separador identificado: ponto e vírgula ';'")
            return df_temp

    except Exception:
        pass

    df_temp = pd.read_csv(
        arquivo,
        sep=None,
        engine="python",
        decimal=".",
        encoding="utf-8-sig"
    )

    print("Separador identificado automaticamente.")
    return df_temp


def converter_numero(valor):
    """
    Converte texto para número.
    Não altera escala, não multiplica e não divide.
    """

    if pd.isna(valor):
        return np.nan

    s = str(valor).strip()

    if s == "" or s.lower() in ["nan", "none", "null"]:
        return np.nan

    s = s.replace(" ", "")

    # Formato brasileiro: 1.234,56
    if "," in s and "." in s:

        if s.rfind(",") > s.rfind("."):
            s = s.replace(".", "")
            s = s.replace(",", ".")

        # Formato americano: 1,234.56
        else:
            s = s.replace(",", "")

    # Apenas vírgula decimal
    elif "," in s:
        s = s.replace(",", ".")

    # Caso com vários pontos
    if s.count(".") > 1:
        partes = s.split(".")
        s = partes[0] + "." + "".join(partes[1:])

    return pd.to_numeric(s, errors="coerce")


def escolher_target(df, opcoes):
    """
    Escolhe automaticamente a coluna de referência existente.
    """

    for col in opcoes:
        if col in df.columns:
            return col

    raise KeyError(
        "Nenhuma coluna de referência foi encontrada.\n"
        f"Opções esperadas: {opcoes}\n\n"
        f"Colunas disponíveis:\n{df.columns.tolist()}"
    )


def calcular_metricas(y_real, y_pred):
    """
    Calcula RMSE, MAE, R2 e Pearson.
    """

    y_real = np.asarray(y_real, dtype=float)
    y_pred = np.asarray(y_pred, dtype=float)

    mse = mean_squared_error(y_real, y_pred)
    rmse = np.sqrt(mse)

    mae = mean_absolute_error(y_real, y_pred)
    r2 = r2_score(y_real, y_pred)

    if len(y_real) > 1 and np.std(y_real) > 0 and np.std(y_pred) > 0:
        pearson = pearsonr(y_real, y_pred)[0]
    else:
        pearson = np.nan

    return {
        "N": len(y_real),
        "RMSE": rmse,
        "MAE": mae,
        "R2": r2,
        "Pearson": pearson
    }


def criar_sequencias(X, y, tempos, janela):
    """
    Cria sequências para a LSTM.
    Cada saída y usa as 'janela' amostras anteriores de X.
    """

    X_seq = []
    y_seq = []
    t_seq = []

    for i in range(janela, len(X)):

        X_seq.append(X[i - janela:i])
        y_seq.append(y[i])
        t_seq.append(tempos[i])

    return (
        np.array(X_seq),
        np.array(y_seq),
        np.array(t_seq)
    )


def transformar_X(scaler, X):
    """
    Aplica normalização em dados 3D da LSTM.
    """

    n_amostras = X.shape[0]
    n_janela = X.shape[1]
    n_features = X.shape[2]

    X_2d = X.reshape(-1, n_features)

    X_2d_scaled = scaler.transform(X_2d)

    X_scaled = X_2d_scaled.reshape(
        n_amostras,
        n_janela,
        n_features
    )

    return X_scaled


def criar_modelo_lstm(janela, n_features):
    """
    Modelo LSTM simples.
    """

    modelo = Sequential([
        Input(shape=(janela, n_features)),

        LSTM(
            64,
            return_sequences=False
        ),

        Dropout(0.20),

        Dense(
            32,
            activation="relu"
        ),

        Dense(1)
    ])

    modelo.compile(
        optimizer=Adam(learning_rate=LEARNING_RATE),
        loss="mse"
    )

    return modelo


def criar_callbacks():
    """
    Callbacks para evitar treino excessivo.
    """

    callbacks = [
        EarlyStopping(
            monitor="val_loss",
            patience=10,
            restore_best_weights=True
        ),

        ReduceLROnPlateau(
            monitor="val_loss",
            factor=0.5,
            patience=4,
            min_lr=1e-5
        )
    ]

    return callbacks


